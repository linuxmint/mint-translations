#: usr/lib/linuxmint/mintnanny/mintnanny.py:32 generate_desktop_files:25
#: generate_desktop_files:39 generate_desktop_files:67
msgid "Domain Blocker"
msgstr "Bloc de dominis"

#. the treeview
#: usr/lib/linuxmint/mintnanny/mintnanny.py:36
msgid "Blocked domains"
msgstr "Dominis blocâts"

#: usr/lib/linuxmint/mintnanny/mintnanny.py:68
msgid "Please type the domain name you want to block"
msgstr "Par plasê, scrîf il non dal domini che tu vuelis blocâ"

#: usr/lib/linuxmint/mintnanny/mintnanny.py:69
msgid "Domain name"
msgstr "Non dal domini"

#. User has passed an invalid domain (one that contains invalid characters)
#. Display an error dialog to inform them why we're not adding it to the list
#: usr/lib/linuxmint/mintnanny/mintnanny.py:99
msgid "Invalid Domain"
msgstr "Domini no valit"

#: usr/lib/linuxmint/mintnanny/mintnanny.py:101
#, python-format
msgid "%s is not a valid domain name."
msgstr "%s nol è un non di domini valit."

#: usr/lib/linuxmint/mintnanny/mintnanny.py:102
msgid ""
"Domain names must start and end with a letter or a digit, and can only "
"contain letters, digits, dots and hyphens."
msgstr ""
"I nons di domini a scugnin scomençâ e finî cuntune letare o un digjit, e a "
"puedin contignî dome letaris, digjits, ponts e tratinis."

#: usr/lib/linuxmint/mintnanny/mintnanny.py:103
msgid "Example: my.number1domain.com"
msgstr "Esempli: my.number1domain.com"

#: generate_desktop_files:25 generate_desktop_files:39
msgid "Block access to selected domain names"
msgstr "Bloche l'asces ai nons di domini sielzûts"

#: generate_desktop_files:39
msgid "Parental Control"
msgstr "Control pargniatril"
