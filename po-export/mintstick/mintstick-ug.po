msgstr "USB ساقلىغۇچتا يېتەرلىك بوشلۇق يوق."

#: lib/mintstick.py:425
msgid "An error occured while copying the image."
msgstr "تەسۋىرنى كۆچۈرۈۋاتقاندا خاتالىق كۆرۈلدى."

