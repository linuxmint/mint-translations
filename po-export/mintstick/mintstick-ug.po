msgstr "مۇكەممەللىك يىغىندىسى توغرا"

#: lib/verify.py:209
msgid ""
"The checksum is correct but the authenticity of the sum was not verified."
msgstr "مۇكەممەللىك يىغىندىسى توغرا ئەمما يىغىندا دەلىللەش ئىسپاتلانمىغان."

#: lib/verify.py:211
msgid "Checksum mismatch"
msgstr "مۇكەممەللىك يىغىندا ماس كەلمىدى"

#: lib/verify.py:212
msgid "Download the ISO image again. Its checksum does not match."
msgstr ""
"ISO تەسۋىرنى قايتا چۈشۈرىدۇ. ئۇنىڭ مۇكەممەللىك يىغىندىسى ماس كەلمىدى."

#: lib/verify.py:223
msgid "The sums file could not be downloaded. Check the URL."
msgstr "يىغىندا ھۆججەتنى چۈشۈرگىلى بولمىدى. تور ئادرېسىنى تەكشۈرۈڭ."

#: lib/verify.py:232
msgid "The gpg file could not be downloaded. Check the URL."
msgstr "gpg ھۆججەتنى چۈشۈرگىلى بولمىدى. تور ئادرېسىنى تەكشۈرۈڭ."

#: lib/verify.py:243
msgid "The sums file could not be checked."
msgstr "يىغىندا ھۆججەتنى تەكشۈرگىلى بولمىدى."

#: lib/verify.py:250
msgid "The gpg file could not be checked."
msgstr "gpg ھۆججەتنى تەكشۈرگىلى بولمىدى."

#: lib/verify.py:260
msgid "Integrity check failed"
msgstr "مۇكەممەللىكنى تەكشۈرەلمىدى"

#: lib/verify.py:269
msgid "The SHA256 sums file is not signed."
msgstr "SHA256 يىغىندا ھۆججەتكە ئىمزا قويۇلمىغان."

#: lib/verify.py:273
#, python-format
msgid "Signed by: %s"
msgstr "ئىمزا قويغۇچى: %s"

#: lib/verify.py:287
msgid "Unknown signature"
msgstr "نامەلۇم ئىمزا"

#: lib/verify.py:288
msgid "Key not found on keyserver."
msgstr "ئاچقۇچ مۇلازىمېتىردا ئاچقۇچ تېپىلمىدى."

#: lib/verify.py:299 lib/verify.py:305
msgid "Everything looks good!"
msgstr "ھەممە ئىش جايىدا كۆرۈنۈۋاتىدۇ!"

#: lib/verify.py:300
msgid "This is an official ISO image."
msgstr "بۇ رەسمىي ISO تەسۋىرى."

#: lib/verify.py:306
msgid "This ISO image is verified by a trusted signature."
msgstr "بۇ ISO تەسۋىر ئىشەنچلىك ئىمزادا دەلىللەنگەن."

#: lib/verify.py:309
msgid "If you trust the signature you can trust the ISO."
msgstr "ئەگەر ئىمزاغا ئىشەنسىڭىز ISO غا ئىشەنسىڭىز بولىدۇ."

#: lib/verify.py:310
msgid "Untrusted signature"
msgstr "ئىشەنچسىز ئىمزا"

#: lib/verify.py:311
msgid "This ISO image is verified by an untrusted signature."
msgstr "بۇ ISO تەسۋىر ئىشەنچسىز ئىمزادا دەلىللەنگەن."

#: lib/verify.py:316
msgid "An error occurred"
msgstr "خاتالىق كۆرۈلدى"

#: lib/verify.py:327
msgid "The SHA256 sum of the ISO image is incorrect."
msgstr "ISO تەسۋىرنىڭ SHA256 يىغىندىسى ناتوغرا."

#: lib/verify.py:328
msgid "The SHA256 sums file does not contain sums for this ISO image."
msgstr ""
"SHA256 يىغىندا ھۆججىتى بۇ ISO تەسۋىرنىڭ يىغىندىسىنى ئۆز ئىچىگە ئالمىغان."

