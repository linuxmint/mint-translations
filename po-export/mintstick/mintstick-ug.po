#: lib/mintstick.py:312
msgid "The USB stick was formatted successfully."
msgstr "USB ساقلىغۇچ مۇۋەپپەقىيەتلىك پىچىلدى."

#: lib/mintstick.py:315
#, python-format
msgid "An error occured while creating a partition on %s."
