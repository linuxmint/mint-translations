#: lib/verify.py:167
msgid "No volume ID found"
msgstr "Kāore i kitea he ID rōrahi"

#: lib/verify.py:208
msgid "The checksum is correct"
msgstr "He tika te manatoko"

#: lib/verify.py:209
msgid ""
"The checksum is correct but the authenticity of the sum was not verified."
msgstr ""
"He tika te manatoko, engari kāore i manatokotia te tūturutanga o taua tapeke."

#: lib/verify.py:211
msgid "Checksum mismatch"
msgstr "Kāore i ōrite te manatoko"

#: lib/verify.py:212
msgid "Download the ISO image again. Its checksum does not match."
msgstr "Tikiake anō i te ata ISO. Kāore i ōrite tōna manatoko."

#: lib/verify.py:223
msgid "The sums file could not be downloaded. Check the URL."
msgstr "Kāore i taea te tikiake te kōnae manatoko. Tirohia te URL."

#: lib/verify.py:232
msgid "The gpg file could not be downloaded. Check the URL."
msgstr "Kāore i taea te tikiake te kōnae GPG. Tirohia te URL."

#: lib/verify.py:243
msgid "The sums file could not be checked."
msgstr "Kāore i taea te arowhai te kōnae manatoko."

#: lib/verify.py:250
msgid "The gpg file could not be checked."
msgstr "Kāore i taea te arowhai te kōnae GPG."

#: lib/verify.py:260
msgid "Integrity check failed"
msgstr "I rahua te arowhai tōtika."

#: lib/verify.py:269
msgid "The SHA256 sums file is not signed."
msgstr "Kāore te kōnae manatoko SHA256 i waitohua."

#: lib/verify.py:273
#, python-format
msgid "Signed by: %s"
msgstr "I waitohua e: %s"

#: lib/verify.py:287
msgid "Unknown signature"
msgstr "Waitohu Kāore i te Mōhiotia"

#: lib/verify.py:288
msgid "Key not found on keyserver."
msgstr "Kāore i kitea te kī i te tūmau kī."

#: lib/verify.py:299 lib/verify.py:305
msgid "Everything looks good!"
msgstr "He pai katoa te āhua!"

#: lib/verify.py:300
msgid "This is an official ISO image."
msgstr "He ata ISO whaimana tēnei."

#: lib/verify.py:306
msgid "This ISO image is verified by a trusted signature."
msgstr "Kua manatokotia tēnei ata ISO e tētahi waitohu whirinaki."

#: lib/verify.py:309
msgid "If you trust the signature you can trust the ISO."
msgstr ""
"Ki te whirinaki koe ki te waitohu, ka taea hoki te whirinaki ki te ISO."

#: lib/verify.py:310
msgid "Untrusted signature"
msgstr "Waitohu Kāore e Whirinakitia"

#: lib/verify.py:311
msgid "This ISO image is verified by an untrusted signature."
msgstr "Kua manatokotia tēnei ata ISO e tētahi waitohu kāore e whirinakitia."

#: lib/verify.py:316
msgid "An error occurred"
msgstr "I puta he hapa"

#: lib/verify.py:327
msgid "The SHA256 sum of the ISO image is incorrect."
msgstr "He hē te manatoko SHA256 o te ata ISO."

#: lib/verify.py:328
msgid "The SHA256 sums file does not contain sums for this ISO image."
msgstr "Kāore te kōnae manatoko SHA256 e whai manatoko mō tēnei ata ISO."

