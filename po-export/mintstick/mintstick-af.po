#: lib/verify.py:208
msgid "The checksum is correct"
msgstr "Die kontrolesom is korrek"

#: lib/verify.py:209
msgid ""
"The checksum is correct but the authenticity of the sum was not verified."
msgstr ""
"Die kontrolesom is korrek, maar die egtheid van die som is nie geverifieer "
"nie."

#: lib/verify.py:211
msgid "Checksum mismatch"
msgstr "Kontrolesom stem nie ooreen nie"

#: lib/verify.py:212
msgid "Download the ISO image again. Its checksum does not match."
msgstr "Laai die ISO-beeld weer af. Die kontrolesom stem nie ooreen nie."

#: lib/verify.py:223
msgid "The sums file could not be downloaded. Check the URL."
msgstr "Die somme-lêer kon nie afgelaai word nie. Gaan die URL na."

#: lib/verify.py:232
msgid "The gpg file could not be downloaded. Check the URL."
msgstr "Die gpg-lêer kon nie afgelaai word nie. Gaan die URL na."

#: lib/verify.py:243
msgid "The sums file could not be checked."
msgstr "Die somme-lêer kon nie nagegaan word nie."

#: lib/verify.py:250
msgid "The gpg file could not be checked."
msgstr "Die gpg-lêer kon nie nagegaan word nie."

#: lib/verify.py:260
msgid "Integrity check failed"
msgstr "Integriteitkontrole het misluk"

#: lib/verify.py:269
msgid "The SHA256 sums file is not signed."
msgstr "Die SHA256-somme-lêer is nie onderteken nie."

#: lib/verify.py:273
#, python-format
msgid "Signed by: %s"
msgstr "Onderteken deur: %s"

#: lib/verify.py:287
msgid "Unknown signature"
msgstr "Onbekende handtekening"

#: lib/verify.py:288
msgid "Key not found on keyserver."
msgstr "Sleutel nie op die sleutelbediener gevind nie."

#: lib/verify.py:299 lib/verify.py:305
msgid "Everything looks good!"
msgstr "Alles lyk goed!"

#: lib/verify.py:300
msgid "This is an official ISO image."
msgstr "Dit is 'n amptelike ISO-beeld."

#: lib/verify.py:306
msgid "This ISO image is verified by a trusted signature."
msgstr "Hierdie ISO-beeld is geverifieer deur 'n betroubare handtekening."

#: lib/verify.py:309
msgid "If you trust the signature you can trust the ISO."
msgstr "As jy die handtekening vertrou, kan jy die ISO vertrou."

#: lib/verify.py:310
msgid "Untrusted signature"
msgstr "Onbetroubare handtekening"

#: lib/verify.py:311
msgid "This ISO image is verified by an untrusted signature."
msgstr "Hierdie ISO-beeld is geverifieer deur 'n onbetroubare handtekening."

#: lib/verify.py:316
msgid "An error occurred"
msgstr "'n Fout het voorgekom"

#: lib/verify.py:327
msgid "The SHA256 sum of the ISO image is incorrect."
msgstr "Die SHA256-som van die ISO-beeld is verkeerd."

#: lib/verify.py:328
msgid "The SHA256 sums file does not contain sums for this ISO image."
msgstr "Die SHA256-somme-lêer bevat nie somme vir hierdie ISO-beeld nie."

