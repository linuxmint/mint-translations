msgstr "چىقىرىۋەت"

#: usr/share/linuxmint/mintlocale/install_remove.ui.h:5
msgid "Remove the selected language"
msgstr "تاللانغان تىلنى چىقىرىۋەت"

#: usr/share/linuxmint/mintlocale/install_remove.ui.h:6
msgid "Install language packs"
msgstr "تىل بوغچىسى ئورنات"

#: usr/share/linuxmint/mintlocale/install_remove.ui.h:7
msgid ""
"Install any missing language packs, translations files, dictionaries for the "
"selected language"
msgstr "تاللىغان تىلنىڭ كەم تىل بوغچىسى، تەرجىمە ھۆججىتى، لۇغىتىنى ئورنىتىدۇ"

#: usr/share/linuxmint/mintlocale/install_remove.ui.h:8
