#: usr/lib/linuxmint/mintbackup/mintbackup.py:37
msgid "Backups"
msgstr "زاپاسلاش"

#: usr/lib/linuxmint/mintbackup/mintbackup.py:170
#: usr/lib/linuxmint/mintbackup/mintbackup.py:232 generate_desktop_files:24
#: generate_desktop_files:39 usr/share/linuxmint/mintbackup/mintbackup.ui.h:35
msgid "Backup Tool"
msgstr "زاپاسلاش قورالى"

#: usr/lib/linuxmint/mintbackup/mintbackup.py:212
#: usr/lib/linuxmint/mintbackup/mintbackup.py:885
msgid "About"
msgstr "ھەققىدە"

#: usr/lib/linuxmint/mintbackup/mintbackup.py:217
msgid "Quit"
msgstr "چېكىن"

#: usr/lib/linuxmint/mintbackup/mintbackup.py:256
#, python-format
msgid "%s is not located in your home directory."
msgstr "%s باش مۇندەرىجىڭىزدە ئەمەس."

#: usr/lib/linuxmint/mintbackup/mintbackup.py:319
msgid "Please choose a directory."
msgstr "بىر قىسقۇچ تاللاڭ."

#: usr/lib/linuxmint/mintbackup/mintbackup.py:322
msgid "You do not have the permission to write in the selected directory."
msgstr "تاللىغان مۇندەرىجىگە يېزىش ئىجازىتىڭىز يوق."

#: usr/lib/linuxmint/mintbackup/mintbackup.py:382
msgid "Please choose a backup file."
msgstr "زاپاسلاش ھۆججىتىدىن بىرنى تاللاڭ."

#: usr/lib/linuxmint/mintbackup/mintbackup.py:390
msgid ""
"This backup file is either too old or it was created with a different tool. "
"Please extract it manually."
msgstr ""
"بۇ زاپاس ھۆججەت بەك كونا ياكى ئۇ پەرقلىق قورالدا قۇرۇلغان. ئۇنى قولدا يېشىڭ."

#: usr/lib/linuxmint/mintbackup/mintbackup.py:399
#, python-format
msgid "An error occurred while opening the backup file: %s."
msgstr "زاپاس ھۆججەتنى ئېچىۋاتقاندا خاتالىق كۆرۈلدى: %s."

#: usr/lib/linuxmint/mintbackup/mintbackup.py:413
msgid "No packages need to be installed."
msgstr "ھېچقانداق بوغچا ئورنىتىش كېرەك ئەمەس."

#: usr/lib/linuxmint/mintbackup/mintbackup.py:420
msgid "Please select packages to install."
msgstr "ئورنىتىدىغان يۇمشاق دېتالنى تاللاڭ."

#: usr/lib/linuxmint/mintbackup/mintbackup.py:474
#, python-format
msgid "Skipping %s because named pipes are not supported."
msgstr "%s دىن ئاتلاۋاتىدۇ چۈنكى ئاتالغان قانال قوللىمايدۇ."

#: usr/lib/linuxmint/mintbackup/mintbackup.py:499
msgid "Backing up:"
msgstr "زاپاسلاش:"

#: usr/lib/linuxmint/mintbackup/mintbackup.py:507
msgid "Calculating..."
msgstr "ھېسابلاۋاتىدۇ..."

#: usr/lib/linuxmint/mintbackup/mintbackup.py:511
#: usr/lib/linuxmint/mintbackup/mintbackup.py:615
msgid "The following errors occurred:"
msgstr "تۆۋەندىكى خاتالىق يۈز بەردى:"

#: usr/lib/linuxmint/mintbackup/mintbackup.py:517
msgid "The backup was aborted."
msgstr "زاپاسلاش بىكار قىلىنغان."

#: usr/lib/linuxmint/mintbackup/mintbackup.py:521
#, python-format
msgid "Your files were successfully saved in %s."
msgstr "ھۆججەتلىرىڭىز %s غا مۇۋەپپەقىيەتلىك ساقلانغان."

#: usr/lib/linuxmint/mintbackup/mintbackup.py:562
msgid ""
"Warning: The meta file could not be saved. This backup will not be accepted "
"for restoration."
msgstr ""
"ئاگاھلاندۇرۇش: تەپسىلىي ئۇچۇر ھۆججىتىنى ساقلىيالمايدۇ. بۇ زاپاسلاشنى ئەسلىگە "
"قايتۇرۇشقا قوشۇلمايدۇ."

#: usr/lib/linuxmint/mintbackup/mintbackup.py:589
#, python-format
msgid ""
"Warning: Some files were not saved. Only %(archived)d files were backed up "
"out of %(total)d."
msgstr ""
"ئاگاھلاندۇرۇش: بەزى ھۆججەت ساقلانمىغان. %(total)d ھۆججەتتىن پەقەت "
"%(archived)d لا زاپاسلانغان."

#: usr/lib/linuxmint/mintbackup/mintbackup.py:604
msgid "Restoring:"
msgstr "ئەسلىگە كەلتۈرۈۋاتىدۇ:"

#: usr/lib/linuxmint/mintbackup/mintbackup.py:621
msgid "The restoration was aborted."
msgstr "ئەسلىگە كەلتۈرۈش بىكار قىلىنغان."

#: usr/lib/linuxmint/mintbackup/mintbackup.py:625
msgid "Your files were successfully restored."
msgstr "ھۆججەت مۇۋەپپەقىيەتلىك ئەسلىگە كەلتۈرۈلدى."

#: usr/lib/linuxmint/mintbackup/mintbackup.py:713
#, python-format
msgid "Warning: Only %(number)d files were restored out of %(total)d."
msgstr ""
"ئاگاھلاندۇرۇش: %(total)d ھۆججەتتىن پەقەت %(number)d لا ئەسلىگە كەلتۈرۈلگەن."

#: usr/lib/linuxmint/mintbackup/mintbackup.py:738
msgid "The list below shows the applications you installed."
msgstr "تۆۋەندىكى تىزىم ئورنىتىلغان پىروگراممىنى كۆرسىتىدۇ."

#: usr/lib/linuxmint/mintbackup/mintbackup.py:782
#, python-format
msgid "Your software selection was saved in %s"
msgstr "يۇمشاق دېتال تاللىشىڭىز %s غا ساقلانغان"

#: usr/lib/linuxmint/mintbackup/mintbackup.py:798
msgid "The selected file is not a valid software selection."
msgstr "تاللانغان ھۆججەت ئىناۋەتلىك يۇمشاق دېتال تاللىشى ئەمەس."

#: usr/lib/linuxmint/mintbackup/mintbackup.py:803
#: usr/lib/linuxmint/mintbackup/mintbackup.py:846
msgid "An error occurred while reading the file."
msgstr "ھۆججەتنى ئوقۇۋاتقاندا خاتالىق كۆرۈلدى."

#: usr/lib/linuxmint/mintbackup/mintbackup.py:828
msgid "Could not locate the package."
msgstr "بوغچىنىڭ ئورنىنى تاپالمىدى."

#: usr/lib/linuxmint/mintbackup/mintbackup.py:887 generate_desktop_files:24
#: generate_desktop_files:39 usr/share/linuxmint/mintbackup/mintbackup.ui.h:36
msgid "Backup apps and files"
msgstr "پىروگرامما ۋە ھۆججەت زاپاسلا"

#: usr/share/linuxmint/mintbackup/mintbackup.ui.h:1
msgid "Personal data"
msgstr "شەخسىي سانلىق مەلۇمات"

#: usr/share/linuxmint/mintbackup/mintbackup.ui.h:2
msgid "Your files, settings and the content of your home directory"
msgstr "ھۆججەت، تەڭشەك ۋە باش مۇندەرىجىڭىزنىڭ مەزمۇنى"

#: usr/share/linuxmint/mintbackup/mintbackup.ui.h:3
msgid "Restore..."
msgstr "ئەسلىگە كەلتۈر…"

#: usr/share/linuxmint/mintbackup/mintbackup.ui.h:4
msgid "Back Up Now..."
msgstr "ھازىر زاپاسلا…"

#: usr/share/linuxmint/mintbackup/mintbackup.ui.h:5
msgid "Software selection"
msgstr "يۇمشاق دېتال تاللاش"

#: usr/share/linuxmint/mintbackup/mintbackup.ui.h:6
msgid "The list of applications installed on your computer"
msgstr "كومپيۇتېرىڭىزغا ئورنىتىلغان پىروگرامما تىزىمى"

#: usr/share/linuxmint/mintbackup/mintbackup.ui.h:7
msgid "Please select where you want to save the backup file:"
msgstr "زاپاس ھۆججەتنى ساقلايدىغان ئورۇننى تاللاڭ:"

#: usr/share/linuxmint/mintbackup/mintbackup.ui.h:8
msgid ""
"Please add files or directories to the list below to exclude them from the "
"backup."
msgstr ""
"زاپاسلاشنىڭ سىرتىدىكى ھۆججەت ياكى مۇندەرىجىنى تۆۋەندىكى تىزىمدىن قوشۇڭ."

#: usr/share/linuxmint/mintbackup/mintbackup.ui.h:9
msgid "Exclude files"
msgstr "سىرتىدىكى ھۆججەت"

#: usr/share/linuxmint/mintbackup/mintbackup.ui.h:10
msgid "Exclude directories"
msgstr "سىرتىدىكى قىسقۇچ"

#: usr/share/linuxmint/mintbackup/mintbackup.ui.h:11
msgid "Remove"
msgstr "چىقىرىۋەت"

#: usr/share/linuxmint/mintbackup/mintbackup.ui.h:12
msgid ""
"Hidden files and hidden folders located at the root of your home directory "
"are not included by default."
msgstr ""
"كۆڭۈلدىكى ئەھۋالدا باش مۇندەرىجىڭىزدىكى root يەنى غول قىسقۇچتىكى يوشۇرۇن "
"ھۆججەت ۋە يوشۇرۇن قىسقۇچنى ئۆز ئىچىگە ئالمايدۇ."

#: usr/share/linuxmint/mintbackup/mintbackup.ui.h:13
msgid ""
"If you want to include some of them in the backup, please add them to the "
"list below."
msgstr ""
"ئەگەر ئۇلارنى بىر قىسمىنى زاپاستا ئۆز ئىچىگە ئالسۇن دېسىڭىز، تۆۋەندىكى "
"تىزىمغا ئۇلارنى قوشۇڭ."

#: usr/share/linuxmint/mintbackup/mintbackup.ui.h:14
msgid "Include files"
msgstr "ئوز ئىچىگە ئالغان ھۆججەت"

#: usr/share/linuxmint/mintbackup/mintbackup.ui.h:15
msgid "Include directories"
msgstr "ئوز ئىچىگە ئالغان مۇندەرىجە"

#: usr/share/linuxmint/mintbackup/mintbackup.ui.h:16
msgid "Include all"
msgstr "ھەممىسى ئىچىدە"

#: usr/share/linuxmint/mintbackup/mintbackup.ui.h:17
msgid ""
"These files and folders usually contain temporary data or preferences for "
"your applications."
msgstr ""
"بۇ ھۆججەت ۋە قىسقۇچ ئادەتتە پىروگراممىڭىزنىڭ ۋاقىتلىق سانلىق مەلۇماتى ياكى "
"مايىللىقىنى ئۆز ئىچىگە ئالىدۇ."

#: usr/share/linuxmint/mintbackup/mintbackup.ui.h:18
msgid "Please wait while your files are being backed up."
msgstr "ھۆججەتلەر زاپاسلىنىۋاتقاندا سەل كۈتۈڭ."

#: usr/share/linuxmint/mintbackup/mintbackup.ui.h:19
msgid "Please select the backup to restore:"
msgstr "ئەسلىگە قايتۇرىدىغان زاپاسنى تاللاڭ:"

#: usr/share/linuxmint/mintbackup/mintbackup.ui.h:20
msgid "Overwrite existing files?"
msgstr "مەۋجۇت ھۆججەتنى قاپلىۋېتەمدۇ؟"

#: usr/share/linuxmint/mintbackup/mintbackup.ui.h:21
msgid ""
"No, only restore missing files.\n"
"<small>This option is safe and does not affect your existing files.</small>"
msgstr ""
"ياق، پەقەت يوقالغان ھۆججەتنى ئەسلىگە كەلتۈرىدۇ.\n"
"<small>بۇ تاللانما بىخەتەر، مەۋجۇت ھۆججەتكە تەسىر كۆرسەتمەيدۇ.</small>"

#: usr/share/linuxmint/mintbackup/mintbackup.ui.h:23
msgid ""
"Yes, overwrite changes and restore the content of any existing files.\n"
"<small>Use this option with caution. The changes you made to the files since "
"the backup will be lost.</small>"
msgstr ""
"ھەئە، ئۆزگىرىشنى قاپلاپ ۋە مەۋجۇت ھەر قانداق ھۆججەت مەزمۇنى ئەسلىگە "
"كەلتۈرىدۇ.\n"
"<small>بۇ تاللانمىنى ئىشلىتىشتە ئېھتىيات قىلىڭ. ھۆججەتنى زاپاسلىغاندىن كېيىن "
"ئېلىپ بارغان ئۆزگىرىش يوقاپ كېتىدۇ.</small>"

#: usr/share/linuxmint/mintbackup/mintbackup.ui.h:25
msgid "Please wait while your files are being restored."
msgstr "ھۆججەت ئەسلىگە قايتۇرۇلغۇچە كۈتۈڭ."

#: usr/share/linuxmint/mintbackup/mintbackup.ui.h:26
msgid ""
"The list below shows the applications you installed with the Software "
"Manager."
msgstr ""
"تۆۋەندىكى تىزىم يۇمشاق دېتال باشقۇرغۇچتا ئورناتقان پىروگراممىلارنى كۆرسىتىدۇ."

#: usr/share/linuxmint/mintbackup/mintbackup.ui.h:27
msgid "Please select the applications you want to save."
msgstr "ساقلىماقچى بولغان پىروگراممىنى تاللاڭ."

#: usr/share/linuxmint/mintbackup/mintbackup.ui.h:28
msgid "Select all"
msgstr "ھەممىنى تاللا"

#: usr/share/linuxmint/mintbackup/mintbackup.ui.h:29
msgid "Deselect all"
msgstr "ھەممىنى تاللىما"

#: usr/share/linuxmint/mintbackup/mintbackup.ui.h:30
msgid ""
"Note: If you want to save the complete list of all installed packages on the "
"system, please use the command 'dpkg --get-selections > mylist.list' in a "
"terminal."
msgstr ""
"ئەسكەرتىش: ئەگەر سىستېمىغا ئورنىتىلغان بارلىق بوغچىنىڭ تولۇق تىزىمىنى "
"ساقلىماقچى بولسىڭىز، تېرمىنالدا «pkg --get-selections > mylist.list» "
"بۇيرۇقىنى ئىشلىتىڭ."

#: usr/share/linuxmint/mintbackup/mintbackup.ui.h:31
msgid "Please select a saved software selection (.list file):"
msgstr "ساقلانغان يۇمشاق دېتال تاللىنىشىنى تاللاڭ (.list ھۆججەت):"

#: usr/share/linuxmint/mintbackup/mintbackup.ui.h:32
msgid "Select the packages you want to install."
msgstr "ئورنىتىدىغان بوغچا تاللىنىدۇ."

#: usr/share/linuxmint/mintbackup/mintbackup.ui.h:33
msgid "Refresh"
msgstr "يېڭىلا"

#: usr/share/linuxmint/mintbackup/mintbackup.ui.h:34
msgid "All the packages in your software selection are installed."
msgstr "يۇمشاق دېتال تاللىشىڭىزدىكى بارلىق بوغچا ئورنىتىلدى."
